{
  "version": 1,
  "notes": "Project-specific title rules, not a standard occupation taxonomy. Multiple different family matches require review. Generic software/engineering titles are deliberately not split into backend/frontend without title evidence.",
  "families": [
    {
      "name": "Software development",
      "resume_categories": [
        "INFORMATION-TECHNOLOGY"
      ],
      "roles": [
        {
          "name": "Frontend development",
          "pattern": "\\b(front ?end (developer|engineer|software|web)|ui developer|react developer|angular developer)\\b"
        },
        {
          "name": "Backend development",
          "pattern": "\\b(back ?end (developer|engineer|software|web))\\b"
        },
        {
          "name": "Full-stack development",
          "pattern": "\\bfull ?stack\\b"
        },
        {
          "name": "Mobile development",
          "pattern": "\\b((ios|android|mobile) (developer|engineer))\\b"
        },
        {
          "name": "Software testing",
          "pattern": "\\b(sdet|software (test|quality)|qa (automation|engineer)|test automation|etl tester)\\b"
        },
        {
          "name": "Software development (specialty unspecified)",
          "pattern": "\\b(software (engineer\\w*|developer|development|architect|programmer|integration)|software (systems|solutions) (engineer\\w*|developer|architect)|programmer|application developer|applications developer|web developer|java developer|python developer|dotnet developer|net developer|c\\+\\+ developer|embedded.*developer)\\b",
          "exclude": "\\b(cnc|machinist)\\b"
